// ---------------------------------------------------------------------------
// BigQuery y utilidades compartidas
// ---------------------------------------------------------------------------
function consultarBigQuery_(query, location) {
  const loc = location || CONFIG.LOCATION;
  const requestBody = {
    query: query, useLegacySql: false, maxResults: 10000,
    timeoutMs: 120000, location: loc
  };
  let response = BigQuery.Jobs.query(requestBody, CONFIG.PROJECT_ID);
  const jobId = response.jobReference.jobId;
  let intentos = 0;
  while (!response.jobComplete && intentos < 60) {
    Utilities.sleep(2000);
    response = BigQuery.Jobs.getQueryResults(CONFIG.PROJECT_ID, jobId, { location: loc });
    intentos++;
  }
  if (!response.jobComplete) throw new Error('Timeout BigQuery (jobId ' + jobId + ')');

  let allRows = response.rows || [];
  let pageToken = response.pageToken;
  while (pageToken) {
    const pagina = BigQuery.Jobs.getQueryResults(CONFIG.PROJECT_ID, jobId,
      { pageToken: pageToken, location: loc });
    allRows = allRows.concat(pagina.rows || []);
    pageToken = pagina.pageToken;
  }
  if (!allRows.length) return [];

  const schema = response.schema ? response.schema.fields : [];
  return allRows.map(function (row) {
    const obj = {};
    row.f.forEach(function (field, index) {
      const key = schema[index] ? schema[index].name : 'col' + index;
      obj[key] = field.v === null ? null : field.v;
    });
    return obj;
  });
}

function buildQuery_(cfg, limite) {
  const desde = normFechaStr_(cfg.fecha_desde) || '2026-01-01';
  const hasta = normFechaStr_(cfg.fecha_hasta) || fmtISO_(new Date());
  const tope = parseInt(limite, 10);

  const filtroTienda = (cfg.tiendas_web || '').trim()
    ? '  AND LOWER(chk.tienda) IN (' + cfg.tiendas_web.split(',')
        .map(function (t) { return "'" + t.trim().toLowerCase() + "'"; }).join(', ') + ')'
    : '';

  const filtroMedio = '  AND chk.medio_envio_id IN (' + Object.keys(CONFIG.MEDIOS).join(', ') + ')';

  return [
    'SELECT',
    '  chk.id                                                        AS id_venta,',
    "  FORMAT_DATE('%Y-%m-%d', DATE(chk.fecha))                      AS fecha_compra,",
    "  REGEXP_EXTRACT(chk.cp, r'\\d{4}')                             AS codigo_postal,",
    '  chk.localidad                                                 AS localidad,',
    '  chk.tienda                                                    AS tienda,',
    '  chk.medio_envio_id                                            AS medio_envio_id,',
    '  dm.nombreDespachoMedio                                        AS medio_despacho,',
    "  CASE WHEN NULLIF(chk.sucursal_oca, '') IS NOT NULL",
    "       THEN 'SUCURSAL' ELSE 'DOMICILIO' END                    AS tipo_entrega,",
    '  chk.fecha_entrega                                             AS fecha_entrega',
    'FROM `' + CONFIG.PROJECT_ID + '.' + CONFIG.DATASET_CHECKOUT + '.' + CONFIG.TABLA_CHECKOUT + '` chk',
    'LEFT JOIN `' + CONFIG.PROJECT_ID + '.' + CONFIG.DATASET_MASTER + '.despachos_medios` dm',
    '  ON dm.idDespachoMedio = chk.medio_envio_id',
    "WHERE DATE(chk.fecha) BETWEEN DATE('" + desde + "') AND DATE('" + hasta + "')",
    "  AND NULLIF(chk.fecha_entrega, '') IS NOT NULL",
    "  AND NULLIF(chk.cp, '') IS NOT NULL",
    filtroTienda,
    filtroMedio,
    'ORDER BY chk.fecha DESC',
    'LIMIT ' + tope
  ].filter(Boolean).join('\n');
}

function evaluarFila_(r, ref, altas, usaHabiles) {
  const cp = r.codigo_postal ? String(r.codigo_postal) : '';
  const medioId = r.medio_envio_id != null ? Number(r.medio_envio_id) : null;
  const canal = medioId != null && CONFIG.MEDIOS[medioId] ? CONFIG.MEDIOS[medioId] : '';
  const tipo = (r.tipo_entrega || 'DOMICILIO').toUpperCase();

  const fechaCompra = parseISO_(r.fecha_compra);
  const fechaProm = parseFechaEntrega_(r.fecha_entrega);
  const entrada = canal && cp ? ref[canal + '|' + cp] : null;

  function calcular_(tipoCalc) {
    if (!canal) return { resultado: 'SIN CANALIZADOR MAPEADO' };
    if (fechaCompra && altas[canal] && fmtISO_(fechaCompra) < altas[canal]) {
      return { resultado: 'CANALIZADOR NO OPERATIVO A LA FECHA' };
    }
    if (!entrada) return { resultado: 'SIN REFERENCIA DE CP' };
    const p = tipoCalc === 'SUCURSAL'
      ? (entrada.suc != null ? entrada.suc : entrada.dom)
      : (entrada.dom != null ? entrada.dom : entrada.suc);
    if (p == null) return { resultado: 'SIN REFERENCIA DE CP' };
    const ft = usaHabiles ? addBusinessDays_(fechaCompra, p) : addDays_(fechaCompra, p);
    let df = null, res = 'SIN FECHA PROMETIDA';
    if (fechaProm) {
      df = diffDays_(ft, fechaProm);
      res = df < 0 ? 'PROMESA MENOR AL CANALIZADOR' : 'OK';
    }
    return { plazo: p, fechaTeor: ft, diff: df, resultado: res };
  }

  const correcto = calcular_(tipo);
  const opuesto = calcular_(tipo === 'DOMICILIO' ? 'SUCURSAL' : 'DOMICILIO');

  let coincideOp = 'NO', hipotesisOp = 'NO';
  if (fechaProm && opuesto.fechaTeor) {
    coincideOp = diffDays_(opuesto.fechaTeor, fechaProm) === 0 ? 'SI' : 'NO';
    hipotesisOp = (correcto.resultado === 'PROMESA MENOR AL CANALIZADOR' && opuesto.resultado === 'OK') ? 'SI' : 'NO';
  }

  return {
    id_venta: r.id_venta,
    fecha_compra: r.fecha_compra || '',
    cp: cp,
    localidad: r.localidad || '',
    tienda: r.tienda || '',
    canal: canal,
    medio: r.medio_despacho || '',
    tipo: tipo,
    fecha_prometida: fechaProm ? fmtISO_(fechaProm) : '',
    plazo: correcto.plazo,
    fecha_teorica: correcto.fechaTeor ? fmtISO_(correcto.fechaTeor) : '',
    diff: correcto.diff,
    resultado: correcto.resultado,
    plazo_opuesto: opuesto.plazo,
    fecha_teorica_opuesta: opuesto.fechaTeor ? fmtISO_(opuesto.fechaTeor) : '',
    diff_opuesto: opuesto.diff,
    coincide_opuesto: coincideOp,
    hipotesis_opuesto: hipotesisOp,
    tieneRef: !!entrada,
    tieneFecha: !!fechaProm
  };
}

