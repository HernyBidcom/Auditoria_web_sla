  const sh = SpreadsheetApp.getActive().getSheetByName(CONFIG.HOJAS.CANAL);
  const values = sh.getDataRange().getValues();
  const map = {};
  for (let i = 1; i < values.length; i++) {
    const canal = String(values[i][0]).trim().toUpperCase();
    const cp = String(values[i][1]).trim();
    const dom = numOrNull_(values[i][2]);
    const suc = numOrNull_(values[i][3]);
    if (!canal || !cp) continue;
    map[canal + '|' + cp] = { dom: dom, suc: suc };
  }
  return map;
}

function escribirTexto_(sh, values, ncolsForzado) {
  const ncols = ncolsForzado || values[0].length;
  const norm = values.map(function (row) {
    const fila = [];
    for (let j = 0; j < ncols; j++) {
      const c = row && row[j] != null ? row[j] : '';
      fila.push(String(c));
    }
    return fila;
  });
  sh.clear();
  const rango = sh.getRange(1, 1, Math.max(norm.length, 1), ncols);
  rango.setNumberFormat('@');
  rango.setValues(norm);
  sh.setFrozenRows(1);
  sh.autoResizeColumns(1, ncols);
}

function actualizarAuditoria() {
  const ui = SpreadsheetApp.getUi();
  try {
    const cfgDet = readConfig_();
    const ctx = prepararContexto_(ctxLimite_(cfgDet, 'limite_filas', '5000'));
    const out = [];
    const resumen = {};
    let nBQ = ctx.rows.length, nConCanal = 0, nCpEnRef = 0, nConFecha = 0, nAgresivas = 0;
    let nCoincideOp = 0, nHipotesisOp = 0;
    let minF = '', maxF = '';

    ctx.rows.forEach(function (r) {
      const e = evaluarFila_(r, ctx.ref, ctx.altas, ctx.usaHabiles);
      out.push([
        e.id_venta, e.fecha_compra, e.cp, e.localidad, e.tienda, e.canal, e.medio,
        e.tipo, e.fecha_prometida, e.plazo == null ? '' : e.plazo,
        e.fecha_teorica, e.diff == null ? '' : e.diff, e.resultado,
        e.plazo_opuesto == null ? '' : e.plazo_opuesto,
        e.fecha_teorica_opuesta,
        e.diff_opuesto == null ? '' : e.diff_opuesto,
        e.coincide_opuesto,
        e.hipotesis_opuesto
      ]);
      const key = (e.canal || '(sin canal)') + ' | ' + e.resultado;
      resumen[key] = (resumen[key] || 0) + 1;
      if (e.canal) nConCanal++;
      if (e.tieneRef) nCpEnRef++;
      if (e.tieneFecha) nConFecha++;
      if (e.resultado === 'PROMESA MENOR AL CANALIZADOR') nAgresivas++;
      if (e.coincide_opuesto === 'SI') nCoincideOp++;
      if (e.hipotesis_opuesto === 'SI') nHipotesisOp++;
      if (e.fecha_compra) {
        if (!minF || e.fecha_compra < minF) minF = e.fecha_compra;
        if (!maxF || e.fecha_compra > maxF) maxF = e.fecha_compra;
      }
    });

    const resRows = [['Canalizador | Resultado', 'Cantidad']];
    Object.keys(resumen).sort().forEach(function (k) { resRows.push([k, resumen[k]]); });
    resRows.push(['Total ventas', out.length]);
    resRows.push([]);
    resRows.push(['--- Diagnostico ---', '']);
    resRows.push(['Filas traidas de BigQuery', nBQ]);
    resRows.push(['Con canalizador mapeado', nConCanal]);
    resRows.push(['Con CP en la referencia', nCpEnRef]);
    resRows.push(['Con fecha prometida valida', nConFecha]);
    resRows.push(['Promesas menores al canalizador', nAgresivas]);
    resRows.push(['Coinciden exactamente con SLA opuesto', nCoincideOp]);
    resRows.push(['Hipotesis: usan SLA opuesto', nHipotesisOp]);
    resRows.push(['Fecha compra MIN (filas trayidas)', minF]);
    resRows.push(['Fecha compra MAX (filas trayidas)', maxF]);
    resRows.push(['Rango configurado', (normFechaStr_(ctx.cfg.fecha_desde) || '') + ' a ' + (normFechaStr_(ctx.cfg.fecha_hasta) || '')]);
    resRows.push(['Tiendas', ctx.cfg.tiendas_web || '(todas)']);
    resRows.push(['Actualizado', Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm')]);
    escribirTexto_(getOrCreateSheet_(SpreadsheetApp.getActive(), CONFIG.HOJAS.RESUMEN), resRows);

    escribirTexto_(getOrCreateSheet_(SpreadsheetApp.getActive(), CONFIG.HOJAS.OUT),
      [OUT_HEADERS].concat(out));

    ui.alert('Detalle listo. Ventas procesadas: ' + out.length);
  } catch (e) {
    console.error(e);
    ui.alert('Error: ' + e.toString());
  }
}

function actualizarAuditoriaAgregada() {
  const ui = SpreadsheetApp.getUi();
  try {
    const ss = SpreadsheetApp.getActive();
    const cfg = readConfig_();
    const ctx = prepararContexto_(ctxLimite_(cfg, 'limite_filas_agregado', '150000'));

    const agg = {};
    const porMes = {};
    let nAgresivas = 0, nHipotesis = 0;

    ctx.rows.forEach(function (r) {
      const e = evaluarFila_(r, ctx.ref, ctx.altas, ctx.usaHabiles);
      const mes = (e.fecha_compra || '').slice(0, 7);
      const canal = e.canal || '(sin canal)';
      const plazo = e.plazo == null ? '' : e.plazo;

      const k = [mes, canal, e.tipo, e.cp, e.localidad, plazo, e.resultado].join('|');
      if (!agg[k]) {
        agg[k] = [mes, canal, e.tipo, e.cp, e.localidad, plazo, e.resultado, 0];
      }
      agg[k][7]++;

      const k2 = mes + '|' + canal;
      if (!porMes[k2]) porMes[k2] = { mes: mes, canal: canal, total: 0, menores: 0, hipotesis: 0 };
      porMes[k2].total++;
      if (e.resultado === 'PROMESA MENOR AL CANALIZADOR') {
        porMes[k2].menores++;
        nAgresivas++;
      }
      if (e.hipotesis_opuesto === 'SI') {
        porMes[k2].hipotesis++;
        nHipotesis++;
      }
    });

    const aggRows = Object.keys(agg).sort().map(function (k) { return agg[k]; });
    escribirTexto_(getOrCreateSheet_(ss, CONFIG.HOJAS.AGG), [AGG_HEADERS].concat(aggRows));

    const porCpHip = {};
    Object.keys(agg).forEach(function (k) {
      const row = agg[k];
      if (row[6] !== 'PROMESA MENOR AL CANALIZADOR') return;
      const key = row[1] + '|' + row[3] + '|' + row[2];
      if (!porCpHip[key]) {
        porCpHip[key] = { canal: row[1], cp: row[3], tipo: row[2], localidad: row[4], menores: 0 };
      }
      porCpHip[key].menores += row[7];
    });
    const topCpHip = Object.keys(porCpHip).map(function (k) { return porCpHip[k]; })
      .sort(function (a, b) { return b.menores - a.menores; })
      .slice(0, 10);

    const resRows = [['Resumen Ejecutivo']];
    resRows.push([]);
    resRows.push(['Metrica', 'Valor']);
    resRows.push(['Total ventas analizadas', ctx.rows.length]);
    resRows.push(['Promesas menores al canalizador', nAgresivas]);
    resRows.push(['% promesas menores', ctx.rows.length ? String(Math.round(nAgresivas / ctx.rows.length * 1000) / 10).replace('.', ',') + '%' : '']);
    resRows.push(['Hipotesis SLA opuesto', nHipotesis]);
    resRows.push(['% hipotesis SLA opuesto', ctx.rows.length ? String(Math.round(nHipotesis / ctx.rows.length * 1000) / 10).replace('.', ',') + '%' : '']);
    resRows.push(['Grupos (CP x mes) generados', aggRows.length]);
    resRows.push([]);

    resRows.push(['Detalle por mes y canalizador']);
    resRows.push(['Mes', 'Canalizador', 'Total', 'Menores', '% menores', 'Hipotesis', '% hipotesis']);
    Object.keys(porMes).sort().forEach(function (k) {
      const v = porMes[k];
      const pctMen = v.total ? String(Math.round(v.menores / v.total * 1000) / 10).replace('.', ',') + '%' : '';
      const pctHip = v.total ? String(Math.round(v.hipotesis / v.total * 1000) / 10).replace('.', ',') + '%' : '';
      resRows.push([v.mes, v.canal, v.total, v.menores, pctMen, v.hipotesis, pctHip]);
    });
    resRows.push([]);

    resRows.push(['Top 10 CPs con promesas menores']);
    resRows.push(['Canalizador', 'Codigo postal', 'Localidad', 'Tipo entrega', 'Cantidad']);
    topCpHip.forEach(function (v) {
      resRows.push([v.canal, v.cp, v.localidad, v.tipo, v.menores]);
    });
    resRows.push([]);

    resRows.push(['Configuracion']);
    resRows.push(['Rango', (normFechaStr_(cfg.fecha_desde) || '') + ' a ' + (normFechaStr_(cfg.fecha_hasta) || '')]);
    resRows.push(['Tiendas', cfg.tiendas_web || '(todas)']);
    resRows.push(['Dias habiles', String(cfg.usar_dias_habiles || 'SI')]);
    resRows.push(['Actualizado', Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm')]);

    escribirTexto_(getOrCreateSheet_(ss, CONFIG.HOJAS.RESAGG), resRows, 7);

    ui.alert('Agregado listo. Filas BQ: ' + ctx.rows.length);
  } catch (e) {
    console.error(e);
    ui.alert('Error: ' + e.toString());
  }
}

function ctxLimite_(cfg, clave, def) {
  const n = parseInt(cfg[clave] || def, 10);
  return isNaN(n) ? parseInt(def, 10) : n;
}

function prepararContexto_(limite) {
  const cfg = readConfig_();
  const ref = loadCanalizadores_();
  if (!Object.keys(ref).length) {
    throw new Error('La hoja "' + CONFIG.HOJAS.CANAL + '" esta vacia. Corré primero el paso 1.');
  }
  const usaHabiles = String(cfg.usar_dias_habiles || 'SI').toUpperCase().startsWith('SI');
  const altas = {
    OCA: normFechaStr_(cfg.alta_OCA) || '2020-01-01',
    ANDREANI: normFechaStr_(cfg.alta_ANDREANI),
    ENTREGAR: normFechaStr_(cfg.alta_ENTREGAR)
  };
  const query = buildQuery_(cfg, limite);
  console.log(query);
  const rows = consultarBigQuery_(query, CONFIG.LOCATION);
  return { cfg: cfg, ref: ref, altas: altas, usaHabiles: usaHabiles, rows: rows };
}

