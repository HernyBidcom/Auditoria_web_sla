// Utilidades
// ---------------------------------------------------------------------------
function getOrCreateSheet_(ss, name) {
  return ss.getSheetByName(name) || ss.insertSheet(name);
}
function normCell_(v) {
  if (v instanceof Date) return fmtISO_(v);
  return String(v == null ? '' : v).trim();
}
function normFechaStr_(v) {
  if (v instanceof Date) return fmtISO_(v);
  const m = String(v == null ? '' : v).match(/\d{4}-\d{2}-\d{2}/);
  return m ? m[0] : '';
}
function numOrNull_(v) {
  if (v === '' || v == null) return null;
  const n = Number(v);
  return isNaN(n) ? null : n;
}
function fmtISO_(d) {
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}
function parseISO_(s) {
  if (!s) return null;
  const m = String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);
  return m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : null;
}
function parseFechaEntrega_(s) {
  if (!s) return null;
  const m = String(s).trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  return m ? new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1])) : null;
}
function addDays_(d, n) {
  const x = new Date(d.getTime());
  x.setDate(x.getDate() + n);
  return x;
}
function addBusinessDays_(d, n) {
  let x = new Date(d.getTime());
  let added = 0;
  while (added < n) {
    x = addDays_(x, 1);
    const w = x.getDay();
    if (w !== 0 && w !== 6) added++;
  }
  return x;
}
function diffDays_(a, b) {
  return Math.round((b.getTime() - a.getTime()) / 86400000);
}
