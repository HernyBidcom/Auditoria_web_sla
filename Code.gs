// ---------------------------------------------------------------------------
// Menu de spreadsheet (opcional, requiere permiso spreadsheets.currentonly)
// ---------------------------------------------------------------------------
function onOpen() {
  try {
    SpreadsheetApp.getUi()
      .createMenu('Auditoria Web')
      .addItem('1) Crear / refrescar hojas', 'setup')
      .addItem('2) Actualizar auditoria (detalle)', 'actualizarAuditoria')
      .addItem('3) Actualizar agregado (CP x mes)', 'actualizarAuditoriaAgregada')
      .addItem('4) Abrir app web', 'abrirWebApp')
      .addToUi();
  } catch (e) { console.log('onOpen omitido: ' + e); }
}

function abrirWebApp() {
  try {
    const url = ScriptApp.getService().getUrl();
    SpreadsheetApp.getUi().alert('App web:\n\n' + (url || 'Aun no desplegada'));
  } catch (e) { console.log(e); }
}

// ---------------------------------------------------------------------------
// Setup y funciones de spreadsheet (opcional)
// ---------------------------------------------------------------------------
function setup() {
  try {
    const ss = SpreadsheetApp.getActive();
    const shCfg = getOrCreateSheet_(ss, CONFIG.HOJAS.CONFIG);
    shCfg.clear();
    const cfgRows = [
      ['Parametro', 'Valor', 'Notas'],
      ['fecha_desde', '2026-09-01', 'YYYY-MM-DD'],
      ['fecha_hasta', '2026-09-30', 'vacio = hoy'],
      ['tiendas_web', 'gadnic,bidcom', 'separadas por coma; vacio = todas'],
      ['usar_dias_habiles', 'SI', 'SI = salta fines de semana (no feriados)'],
      ['limite_filas', '5000', 'tope para el modo DETALLE'],
      ['limite_filas_agregado', '150000', 'tope para el modo AGREGADO'],
      ['alta_OCA', '2020-01-01', 'fecha de alta del canalizador'],
      ['alta_ANDREANI', '2025-11-01', 'CONFIRMAR fecha real'],
      ['alta_ENTREGAR', '2025-11-01', 'CONFIRMAR fecha real (EnDro)']
    ];
    shCfg.getRange(1, 1, cfgRows.length, cfgRows[0].length).setValues(cfgRows);
    shCfg.setFrozenRows(1);
    shCfg.autoResizeColumns(1, 3);

    volcarCanalizadores_(ss);

    [[CONFIG.HOJAS.OUT, OUT_HEADERS], [CONFIG.HOJAS.AGG, AGG_HEADERS]].forEach(function (par) {
      const sh = getOrCreateSheet_(ss, par[0]);
      sh.clear();
      sh.getRange(1, 1, 1, par[1].length).setValues([par[1]]).setFontWeight('bold');
      sh.setFrozenRows(1);
    });

    [CONFIG.HOJAS.RESUMEN, CONFIG.HOJAS.RESAGG].forEach(function (n) {
      getOrCreateSheet_(ss, n).clear();
    });

    SpreadsheetApp.getUi().alert('Hojas creadas/refrescadas.');
  } catch (e) {
    console.error(e);
    try { SpreadsheetApp.getUi().alert('Error: ' + e.toString()); } catch (e2) {}
  }
}

function volcarCanalizadores_(ss) {
  const sh = getOrCreateSheet_(ss, CONFIG.HOJAS.CANAL);
  sh.clear();
  sh.getRange(1, 1, 1, CANAL_HEADERS.length).setValues([CANAL_HEADERS]).setFontWeight('bold');
  sh.setFrozenRows(1);
  const rows = [];
  CANALIZADORES_DATA.forEach(function (blk) {
    blk.data.split(',').forEach(function (kv) {
      if (!kv) return;
      const p = kv.split(':');
      rows.push([blk.canalizador, p[0], numOrNull_(p[1]), numOrNull_(p[2])]);
    });
  });
  sh.getRange(2, 1, rows.length, CANAL_HEADERS.length).setValues(rows);
  sh.autoResizeColumns(1, CANAL_HEADERS.length);
}

function readConfig_() {
  const sh = SpreadsheetApp.getActive().getSheetByName(CONFIG.HOJAS.CONFIG);
  const values = sh.getDataRange().getValues();
  const cfg = {};
  for (let i = 1; i < values.length; i++) {
    const k = String(values[i][0]).trim();
    if (k) cfg[k] = normCell_(values[i][1]);
  }
  return cfg;
}

